JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

JIRA_FILTER_NAME=Roadmap Mimic app filter
# Optional: use the filter ID instead of the name
JIRA_FILTER_ID=

# Optional overrides of Jira field names used for the public-visibility criteria
# FIELD_ROADMAP=Roadmap?
# FIELD_FIX_VERSION=Fix Version
# FIELD_SECURITY=Security Level
# FIELD_RELEASE_NOTE=Release Note
# FIELD_PUBLIC_NOTES=Public Notes

# Public-site rules (check order: project -> issue type -> security level; first failure stops)
# Allowed project keys from the Support Center admin page (empty = not enforced)
ALLOWED_PROJECTS=
# Allowed issue types from the type map; "Type" for any project or "PROJECT:Type" (empty = not enforced)
ALLOWED_ISSUE_TYPES=
# Security levels (comma-separated, exact match) treated as public; an unset level is not public
PUBLIC_SECURITY_LEVELS=Public-Global
# Fix Versions that make an issue public (comma-separated; at least one must match)
# ALLOWED_FIX_VERSIONS=Current Development,Up Next,Following Release,Future Consideration
