JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

JIRA_FILTER_NAME=Roadmap Mimic app filter
# Optional: use the filter ID instead of the name
JIRA_FILTER_ID=

# Optional overrides of Jira field names used for the public-visibility criteria
# FIELD_ROADMAP=Roadmap?
# FIELD_FIX_VERSION=Fix Version
# FIELD_SECURITY=Security Level
# FIELD_ADD_TO_RELEASE_NOTE=Add to Release Note
# FIELD_RELEASE_NOTE=Release Note
# FIELD_PUBLIC_NOTES=Public Notes

# Security levels (comma-separated substrings) treated as public; unset level is also public
PUBLIC_SECURITY_LEVELS=public
# Select/checkbox values treated as "not set"
NEGATIVE_VALUES=no,false,none,n/a
